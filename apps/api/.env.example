# Backend (milestone 4) — copy to apps/api/.env and fill in.
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/adaptive-layout-engine

# 32+ random bytes; never commit the real value
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
COOKIE_DOMAIN=localhost

# Where the browser app is served from, for CORS and share links
WEB_ORIGIN=http://localhost:5173

# Asset storage: "disk" or "cloudinary"
ASSET_STORAGE=disk
CLOUDINARY_URL=
