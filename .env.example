# Copy to .env (repo root or apps/api/.env — both are read) and fill in.
NODE_ENV=development
PORT=4000

# MongoDB connection string. Atlas: mongodb+srv://user:pass@cluster/db
# Percent-encode any of @ : / ? # [ ] in the password.
MONGODB_URI=mongodb://127.0.0.1:27017/adaptive-layout-engine

# 16 characters minimum; generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Origin allowed by CORS. In production this must be the exact deployed
# frontend URL, or the session cookie is rejected.
WEB_ORIGIN=http://localhost:5173

# Uploads are written to disk. Note that on ephemeral hosts (Render free tier)
# this directory does not survive a redeploy.
ASSET_STORAGE=disk
UPLOAD_DIR=uploads
