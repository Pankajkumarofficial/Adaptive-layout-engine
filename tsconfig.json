{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Never emitted here: tsx runs the API in development and Vercel bundles
    // the function with esbuild. This config exists so that toolchains which
    // look for a tsconfig.json beside the `api/` directory — Vercel's Node
    // builder among them — compile the function's import graph and nothing
    // else. Without it the builder falls back to a default that sweeps the
    // whole repo, and reports hundreds of errors against the React app for
    // missing a `--jsx` flag it was never meant to be compiled with.
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": ["api/**/*.ts"],
  "exclude": ["node_modules", "**/dist", "apps/web", "packages/*/dist"]
}
