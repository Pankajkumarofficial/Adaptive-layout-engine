{
  "name": "adaptive-layout-engine",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Constraint-based layout engine that renders one declarative ad spec across arbitrary surfaces.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace @ale/web",
    "build": "npm run build --workspace @ale/web",
    "demo": "vite-node scripts/demo.ts --",
    "test": "npm run test --workspace @ale/engine",
    "test:watch": "npm run test:watch --workspace @ale/engine",
    "bench": "npm run bench --workspace @ale/engine",
    "typecheck": "tsc -b packages/shared packages/engine && tsc -p tsconfig.scripts.json && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite-node": "^2.1.8",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
